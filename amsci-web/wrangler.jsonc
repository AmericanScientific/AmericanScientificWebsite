/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "amsci-web",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-07-09",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "amsci-web"
		}
	],
	// ── LAUNCH: the public domain ────────────────────────────────────────────────
	// These two entries ARE the cutover. Declaring them here rather than clicking
	// "Connect Worker" in the dashboard means the live hostnames are version
	// controlled, reviewable, and revertable — removing them is a revert plus a
	// deploy, not a memory of what was clicked.
	//
	// `custom_domain: true` makes Cloudflare manage the DNS record and the
	// certificate for each hostname, replacing the grey-cloud A records that
	// currently point at Flywheel. Existing records for OTHER names (MX,
	// autodiscover, mail, campaigns) are untouched — this only claims these two.
	//
	// Both www AND apex are claimed deliberately. Attaching only www would leave
	// the bare domain serving the old WordPress site, so anyone typing
	// american-scientific.com would get the pre-launch site with no indication
	// anything had changed. Serving both from the Worker is the lesser evil; the
	// follow-up is a Cloudflare Redirect Rule sending apex → www so there is one
	// canonical host (www, matching SITE_URL and the SEO redirect map).
	//
	// Rollback: delete these two entries, redeploy. DNS returns to the Flywheel
	// records within the 300s TTL.
	"routes": [
		{ "pattern": "www.american-scientific.com", "custom_domain": true },
		{ "pattern": "american-scientific.com", "custom_domain": true }
	],
	// Catalog cache, populated by the `amsci-sync` Worker on a cron schedule.
	// Create once (`wrangler d1 create amsci-catalog`) and paste the id here AND
	// in sync-worker/wrangler.jsonc. The storefront reads this at runtime via
	// src/data/catalog-source.ts, falling back to catalog.json when absent.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "amsci-catalog",
			"database_id": "53ff7b8e-d672-43d4-aa39-9682003a07e2"
		}
	],
	// Per-IP rate limiters for the AI assistant (/api/chat). Native Cloudflare
	// rate limiting — in-memory at the edge, no storage cost, per-colo. BURST
	// blocks rapid-fire abuse; SUSTAINED bounds per-minute volume. See
	// src/lib/chat/guard.ts. namespace_id is an arbitrary unique number per limiter.
	"ratelimits": [
		{ "name": "CHAT_RL_BURST", "namespace_id": "2001", "simple": { "limit": 6, "period": 10 } },
		{ "name": "CHAT_RL_SUSTAINED", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } }
	],
	// Transactional email (password setup/reset links) via Resend — see
	// src/lib/auth/email.ts. Setup: verify the sender domain (am-sci.com) in
	// Resend, add its DNS records, then `wrangler secret put RESEND_API_KEY`.
	// Until RESEND_API_KEY is set, sends are skipped and the link is logged.
	// EMAIL_FROM must be an address on the Resend-verified domain. Set SITE_URL to
	// the deployed origin so links in emails are absolute (falls back to the
	// request origin if unset). RESEND_API_KEY is a SECRET, not a var.
	// SITE_URL is now PINNED for launch. It was unset, which meant links in
	// password setup/reset emails were built from the request origin — fine while
	// the only origin was the workers.dev URL, but wrong the moment a link is
	// generated from anywhere other than the public domain. A "set your password"
	// email pointing at staging.phywe-usa.com is one a customer will not trust.
	// TURNSTILE_SITE_KEY is the PUBLIC widget key — it ships to the browser by
	// design, so it belongs in vars, not secrets. Its partner
	// TURNSTILE_SECRET_KEY is a secret (`wrangler secret put`) and is what
	// actually enforces anything: with the site key set but the secret missing,
	// the widget renders and the visitor solves it while the server accepts every
	// submission regardless (see verifyTurnstile — no secret means skip). Both or
	// neither; the site key alone is decoration.
	// Widget hostnames: american-scientific.com + phywe-usa.com (subdomains
	// included), so signup verifies on the staging host before the DNS cutover.
	"vars": {
		"EMAIL_FROM": "hello@am-sci.com",
		"EMAIL_FROM_NAME": "American Scientific",
		"SITE_URL": "https://www.american-scientific.com",
		"TURNSTILE_SITE_KEY": "0x4AAAAAAEGMtTkfgY3zbNWq"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
}